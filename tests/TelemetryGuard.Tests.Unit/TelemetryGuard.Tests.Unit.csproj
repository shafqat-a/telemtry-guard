<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <!-- API-01 pipeline tests: WebApplicationFactory<Program>. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.30" />
    <!-- ANA-05 registration tests: real ServiceCollection/ConfigurationBuilder + Host.CreateApplicationBuilder. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- API-02 tracker tests: IConnectionMultiplexer/IDatabase fakes. -->
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- API-02 env-gated perf test ([RUN_PERF_TESTS=1] SkippableFact). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TelemetryGuard.Core\TelemetryGuard.Core.csproj" />
    <ProjectReference Include="..\..\TelemetryGuard.RiskEngine\TelemetryGuard.RiskEngine.csproj" />
    <ProjectReference Include="..\..\TelemetryGuard.RiskEngine.Contracts\TelemetryGuard.RiskEngine.Contracts.csproj" />
    <ProjectReference Include="..\..\TelemetryGuard.Analytics.Abstractions\TelemetryGuard.Analytics.Abstractions.csproj" />
    <ProjectReference Include="..\..\TelemetryGuard.Analytics.ClickHouse\TelemetryGuard.Analytics.ClickHouse.csproj" />
    <ProjectReference Include="..\..\TelemetryGuard.Data\TelemetryGuard.Data.csproj" />
    <ProjectReference Include="..\..\TelemetryGuard.Integrations\TelemetryGuard.Integrations.csproj" />
    <ProjectReference Include="..\..\TelemetryGuard.Api\TelemetryGuard.Api.csproj" />
    <!-- RSK-08: Trainer/LabelResolver smoke + AUC-gate tests invoke the Training
         project's classes directly (not the process). -->
    <ProjectReference Include="..\..\TelemetryGuard.Training\TelemetryGuard.Training.csproj" />
  </ItemGroup>

</Project>
