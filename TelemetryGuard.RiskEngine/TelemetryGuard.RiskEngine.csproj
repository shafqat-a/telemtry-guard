<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TelemetryGuard.Core\TelemetryGuard.Core.csproj" />
    <ProjectReference Include="..\TelemetryGuard.RiskEngine.Contracts\TelemetryGuard.RiskEngine.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeviceDetector.NET" Version="6.4.2" />
    <PackageReference Include="IP2Proxy" Version="4.2.0" />
    <!-- D24: the iplegence provider reads Superior-IP.mmdb with the raw MMDB reader and a
         custom record type. It arrives transitively via MaxMind.GeoIP2, but it is a direct
         dependency here, so it is declared directly. -->
    <PackageReference Include="MaxMind.Db" Version="4.1.0" />
    <PackageReference Include="MaxMind.GeoIP2" Version="5.2.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <!-- RSK-08 (Phase 1.5, D18): serving side of the LightGBM listen-only model —
         PredictionEnginePool keeps inference in-process/pooled, sub-millisecond,
         well inside the < 50 ms scoring budget (D3). No model-server sidecar. -->
    <PackageReference Include="Microsoft.ML" Version="4.0.2" />
    <PackageReference Include="Microsoft.ML.LightGbm" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.ML" Version="4.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Enrichment\Data\datacenter-asns.txt" LogicalName="TelemetryGuard.RiskEngine.Enrichment.Data.datacenter-asns.txt" />
    <EmbeddedResource Include="Enrichment\Data\cdn-asns.txt" LogicalName="TelemetryGuard.RiskEngine.Enrichment.Data.cdn-asns.txt" />
    <EmbeddedResource Include="Enrichment\Data\apple-private-relay-seed.csv" LogicalName="TelemetryGuard.RiskEngine.Enrichment.Data.apple-private-relay-seed.csv" />
    <EmbeddedResource Include="Features\Data\tls-fingerprints.json" LogicalName="TelemetryGuard.RiskEngine.Features.Data.tls-fingerprints.json" />
    <EmbeddedResource Include="Features\Data\country-languages.json" LogicalName="TelemetryGuard.RiskEngine.Features.Data.country-languages.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TelemetryGuard.Tests.Unit" />
  </ItemGroup>

</Project>
